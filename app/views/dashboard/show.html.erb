<% content_for :title, "Inicio - Sistema de Recomendaciones - Jardín LAC Vizcaínas" %>

<section class="hero">
  <h1>Sistema de Recomendaciones - Jardín LAC Vizcaínas</h1>
  <p>Un motor de recomendación híbrido que asocia embeddings semánticos de libros y redes de préstamos de usuarios.</p>
</section>

<% if notice %>
  <div class="notice-banner" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i> <%= notice %>
  </div>
<% end %>

<div class="stats-grid">
  <div class="glass-card stat-card">
    <div class="stat-icon users">
      <i class="fa-solid fa-users" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Lectores</p>
      <p class="stat-value"><%= number_with_delimiter(@total_users) %></p>
    </div>
  </div>
  <div class="glass-card stat-card">
    <div class="stat-icon books">
      <i class="fa-solid fa-book" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Títulos Únicos</p>
      <p class="stat-value"><%= number_with_delimiter(@total_books) %></p>
    </div>
  </div>
  <div class="glass-card stat-card">
    <div class="stat-icon checkouts">
      <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Préstamos Totales</p>
      <p class="stat-value"><%= number_with_delimiter(@total_checkouts) %></p>
    </div>
  </div>
</div>

<div class="dashboard-grid">
  <div class="glass-card"
       data-controller="search"
       data-search-url-value="<%= users_search_path %>"
       data-search-singular-value="lector"
       data-search-plural-value="lectores">
    <div class="section-title">
      <i class="fa-solid fa-address-book section-title-icon--accent" aria-hidden="true"></i>
      <h2>Directorio de Lectores</h2>
    </div>

    <form role="search"
          action="<%= root_path %>"
          method="get"
          class="search-form"
          data-action="submit->search#submitNow">
      <div class="search-container">
        <div class="search-input-wrap">
          <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
          <label for="dashboard-user-search" class="sr-only">Buscar lectores por nombre, correo o credencial</label>
          <input type="search"
                 id="dashboard-user-search"
                 name="q"
                 class="search-input"
                 placeholder="Buscar lectores por nombre, correo o número de credencial..."
                 data-search-target="input"
                 data-action="input->search#input">
        </div>
        <button type="button"
                class="search-clear-btn"
                data-search-target="clear"
                data-action="click->search#clear"
                hidden>
          Limpiar
        </button>
      </div>
    </form>
    <div class="search-feedback-row">
      <p class="search-status" data-search-target="status" aria-live="polite">
        Mostrando <%= pluralize_es(@users.size, "lector", "lectores") %>
      </p>
    </div>

    <div class="directory-scroll-container">
      <%= render "dashboard/users_table", users: @users %>
    </div>
  </div>

  <div class="sidebar-stack">
    <div class="glass-card">
      <div class="section-title">
        <i class="fa-solid fa-fire section-title-icon--collab" aria-hidden="true"></i>
        <h2>Libros Más Solicitados</h2>
      </div>
      <div class="popular-books-list">
        <% @popular_books.each_with_index do |book, idx| %>
          <div class="popular-book-row">
            <div class="popular-book-main">
              <span class="popular-book-rank">#<%= idx + 1 %></span>
              <%= link_to book.title, book_path(book.id), class: "book-title-link", title: book.title %>
            </div>
            <span class="source-badge collaborative popular-book-badge">
              <i class="fa-solid fa-check" aria-hidden="true"></i> <%= pluralize_es(book.checkouts_count, "lectura", "lecturas") %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
