<%= turbo_frame_tag "users-table", data: { search_target: "frame" } do %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Credencial</th>
          <th>Correo Electrónico</th>
          <th class="text-center">Préstamos</th>
          <th class="text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if users.empty? %>
          <tr>
            <td class="no-label table-empty-cell" colspan="5">
              No se encontraron lectores.
            </td>
          </tr>
        <% else %>
          <% users.each do |user| %>
            <tr data-search-result-item>
              <td>
                <%= link_to user.name, user_path(user.id), data: { turbo_frame: "_top" }, class: "user-name-link", title: user.name %>
              </td>
              <td class="user-cardnumber"><%= user.cardnumber %></td>
              <td class="user-email"><%= user.email %></td>
              <td class="text-center user-checkouts-count">
                <%= number_with_delimiter(user.checkouts_count) %>
              </td>
              <td class="text-right">
                <div class="table-actions">
                  <%= link_to "Recomendar", user_path(user.id), data: { turbo_frame: "_top" }, class: "btn btn-primary btn-compact" %>
                  <%= link_to "Grafo", user_graph_path(user.id), data: { turbo_frame: "_top" }, class: "btn btn-secondary btn-compact" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
