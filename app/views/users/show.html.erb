<% content_for :title, "Recomendaciones para #{@patron.name} - Jardín LAC Vizcaínas" %>

<div class="page-actions-bar">
  <%= link_to root_path, class: "btn btn-secondary back-nav-btn" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver a la Lista
  <% end %>
  <%= link_to user_graph_path(@patron.id), class: "btn btn-secondary back-nav-btn" do %>
    <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Ver Grafo de Red
  <% end %>
</div>

<% if notice %>
  <div class="notice-banner" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i> <%= notice %>
  </div>
<% end %>

<div class="glass-card patron-banner">
  <div class="patron-banner-inner">
    <div class="patron-avatar" aria-hidden="true">
      <%= patron_initials(@patron.name) %>
    </div>
    <div class="patron-banner-details">
      <h1 class="patron-banner-title"><%= @patron.name %></h1>
      <div class="patron-banner-meta">
        <span><i class="fa-solid fa-id-card" aria-hidden="true"></i> <%= @patron.cardnumber %></span>
        <span><i class="fa-solid fa-envelope" aria-hidden="true"></i> <%= @patron.email %></span>
        <span><i class="fa-solid fa-book-reader" aria-hidden="true"></i> <%= pluralize_es(@patron.checkouts_count, "lectura", "lecturas") %></span>
      </div>
    </div>
  </div>
</div>

<div class="split-view" data-controller="balance" data-balance-url-value="<%= user_recommendations_frame_path(@patron.id) %>">
  <div class="sidebar-stack">
    <div class="glass-card">
      <div class="balance-header">
        <div class="section-title">
          <i class="fa-solid fa-sliders section-title-icon--accent" aria-hidden="true"></i>
          <h2>Balance Híbrido</h2>
        </div>
        <button type="button"
                class="btn btn-secondary btn-compact balance-reset-btn"
                data-action="click->balance#reset">
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Restablecer
        </button>
      </div>
      <p class="section-subtitle">
        Ajusta la ponderación en tiempo real para combinar las 3 dimensiones del recomendador.
      </p>

      <div class="balance-sliders-list">
        <div>
          <div class="slider-header">
            <label for="slider-content" class="slider-label slider-label--content">
              <i class="fa-solid fa-book" aria-hidden="true"></i> Contenido
            </label>
            <span data-balance-target="contentVal"><%= (@w_content * 100).round %>%</span>
          </div>
          <input type="range"
                 id="slider-content"
                 min="0"
                 max="1"
                 step="0.01"
                 value="<%= @w_content %>"
                 aria-valuetext="<%= (@w_content * 100).round %>%"
                 class="slider-range-content"
                 data-balance-target="contentSlider"
                 data-action="input->balance#update">
        </div>

        <div>
          <div class="slider-header">
            <label for="slider-collab" class="slider-label slider-label--collab">
              <i class="fa-solid fa-users" aria-hidden="true"></i> Lectores Afines
            </label>
            <span data-balance-target="collabVal"><%= (@w_collab * 100).round %>%</span>
          </div>
          <input type="range"
                 id="slider-collab"
                 min="0"
                 max="1"
                 step="0.01"
                 value="<%= @w_collab %>"
                 aria-valuetext="<%= (@w_collab * 100).round %>%"
                 class="slider-range-collab"
                 data-balance-target="collabSlider"
                 data-action="input->balance#update">
        </div>

        <div>
          <div class="slider-header">
            <label for="slider-auth" class="slider-label slider-label--auth">
              <i class="fa-solid fa-tags" aria-hidden="true"></i> Autoridades
            </label>
            <span data-balance-target="authVal"><%= (@w_auth * 100).round %>%</span>
          </div>
          <input type="range"
                 id="slider-auth"
                 min="0"
                 max="1"
                 step="0.01"
                 value="<%= @w_auth %>"
                 aria-valuetext="<%= (@w_auth * 100).round %>%"
                 class="slider-range-auth"
                 data-balance-target="authSlider"
                 data-action="input->balance#update">
        </div>
      </div>

      <p class="balance-status" data-balance-target="status" role="status" aria-live="polite" hidden></p>
    </div>

    <div class="glass-card">
      <div class="section-title section-title--tight">
        <i class="fa-solid fa-clock-rotate-left section-title-icon--collab" aria-hidden="true"></i>
        <h2>Historial de Lectura</h2>
      </div>

      <div class="checkout-list">
        <% if @checkouts.empty? %>
          <p class="checkout-empty">No hay préstamos registrados para este lector.</p>
        <% else %>
          <% @checkouts.each do |c| %>
            <div class="checkout-item">
              <div class="checkout-item-main">
                <%= link_to c.book.title, book_path(c.book.id), class: "checkout-item-title", title: c.book.title %>
                <% if c.simulated %>
                  <span class="checkout-simulated-tag">(Simulado)</span>
                <% end %>
              </div>
              <span class="checkout-date">
                <%= c.checkout_date ? c.checkout_date.strftime("%d/%m/%Y") : "Sin fecha" %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="glass-card">
    <div class="section-title">
      <i class="fa-solid fa-wand-magic-sparkles section-title-icon--hybrid" aria-hidden="true"></i>
      <h2>Sugerencias Híbridas de Lectura</h2>
    </div>

    <%= render "users/recommendations_list", recommendations: @recommendations %>
  </div>
</div>
