<% content_for :title, "Grafo de Red de #{@patron.name} - Jardín LAC Vizcaínas" %>

<div class="page-actions-bar">
  <%= link_to user_path(@patron.id), class: "btn btn-secondary back-nav-btn" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver a Recomendaciones
  <% end %>
</div>

<div class="glass-card graph-hero-card">
  <div class="graph-hero-header">
    <i class="fa-solid fa-diagram-project graph-hero-icon graph-hero-icon--accent" aria-hidden="true"></i>
    <div>
      <h1 class="graph-hero-title">
        Grafo de Afinidad y Red de Lectura: <%= @patron.name %>
      </h1>
      <p class="graph-hero-subtitle">
        Visualización topológica interactiva de lectores afines, préstamos compartidos y recomendaciones colaborativas.
      </p>
    </div>
  </div>
  <div class="graph-help-row">
    <span class="graph-help-chip"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Arrastra nodos</span>
    <span class="graph-help-chip"><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i> Rueda para zoom</span>
    <span class="graph-help-chip"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Clic o Enter para detalles</span>
  </div>
</div>

<div class="graph-split" data-controller="d3-user-graph" data-d3-user-graph-url-value="<%= api_user_graph_path(@patron.id) %>">
  <div class="glass-card graph-canvas-card">
    <div class="graph-toolbar" role="toolbar" aria-label="Controles de zoom del grafo">
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-user-graph#zoomIn"
              data-d3-user-graph-target="zoomControl"
              aria-label="Acercar grafo"
              title="Acercar">+</button>
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-user-graph#zoomOut"
              data-d3-user-graph-target="zoomControl"
              aria-label="Alejar grafo"
              title="Alejar">-</button>
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-user-graph#resetZoom"
              data-d3-user-graph-target="zoomControl">Restablecer</button>
    </div>

    <div class="graph-loading-state" data-d3-user-graph-target="loading">
      <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
      <span>Cargando grafo…</span>
    </div>
    <div id="graph-container" class="graph-canvas" data-d3-user-graph-target="container"></div>

    <div class="graph-legend">
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--target-user" aria-hidden="true"></span> Lector Principal
      </div>
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--target-book" aria-hidden="true"></span> Préstamo Propio
      </div>
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--similar-user" aria-hidden="true"></span> Lector Afín
      </div>
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--collab-book" aria-hidden="true"></span> Recomendación Colaborativa
      </div>
    </div>
  </div>

  <div class="glass-card graph-panel" data-d3-user-graph-target="panel" aria-live="polite">
    <div class="graph-panel-placeholder">
      <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
      <p class="graph-panel-placeholder-title">Selecciona un nodo del grafo</p>
      <p class="graph-panel-placeholder-copy">Haz clic en cualquier lector u obra para inspeccionar sus conexiones y métricas.</p>
    </div>
  </div>
</div>
