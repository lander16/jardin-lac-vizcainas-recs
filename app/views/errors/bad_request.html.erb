<% content_for :title, "Solicitud Inválida (400) - Jardín LAC Vizcaínas" %>

<div class="error-page-wrap">
  <div class="glass-card error-card">
    <div class="error-icon error-icon--warning">
      <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
    </div>

    <h1 class="error-title">Solicitud Inválida (400)</h1>

    <p class="error-copy">
      La solicitud enviada no pudo interpretarse correctamente. Verifica los parámetros e intenta de nuevo.
    </p>

    <div class="error-actions">
      <%= link_to root_path, class: "btn btn-primary error-action-btn" do %>
        <i class="fa-solid fa-house" aria-hidden="true"></i> Volver al Inicio
      <% end %>
      <%= link_to catalog_path, class: "btn btn-outline error-action-btn" do %>
        <i class="fa-solid fa-building-columns" aria-hidden="true"></i> Explorar Catálogo
      <% end %>
    </div>
  </div>
</div>
