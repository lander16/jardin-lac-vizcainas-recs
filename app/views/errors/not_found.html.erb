<% content_for :title, "Página no Encontrada (404) - Jardín LAC Vizcaínas" %>

<div class="error-page-wrap">
  <div class="glass-card error-card">
    <div class="error-icon error-icon--accent">
      <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
    </div>

    <h1 class="error-title">Registro no Encontrado (404)</h1>

    <p class="error-copy">
      El lector, obra bibliográfica o recurso solicitado no existe en el catálogo o ha cambiado de identificador.
    </p>

    <div class="error-actions">
      <%= link_to root_path, class: "btn btn-primary error-action-btn" do %>
        <i class="fa-solid fa-house" aria-hidden="true"></i> Volver al Inicio
      <% end %>
      <%= link_to catalog_path, class: "btn btn-outline error-action-btn" do %>
        <i class="fa-solid fa-building-columns" aria-hidden="true"></i> Explorar Catálogo
      <% end %>
    </div>
  </div>
</div>
