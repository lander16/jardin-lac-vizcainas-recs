<% content_for :title, "Página no Encontrada (404) - Jardín LAC Vizcaínas" %>

<div style="max-width: 650px; margin: 3rem auto; text-align: center;">
  <div class="glass-card" style="padding: 2.5rem 1.5rem; text-align: center;">
    <div style="font-size: 3.5rem; color: var(--color-accent); margin-bottom: 1rem;">
      <i class="fa-solid fa-book-open-reader"></i>
    </div>
    
    <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem;">
      Registro no Encontrado (404)
    </h1>
    
    <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.75rem; max-width: 500px; margin-left: auto; margin-right: auto;">
      El lector, obra bibliográfica o recurso solicitado no existe en el catálogo o ha cambiado de identificador.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="<%= root_path %>" class="btn btn-primary" style="padding: 0.6rem 1.25rem;">
        <i class="fa-solid fa-house"></i> Volver al Inicio
      </a>
      <a href="<%= catalog_path %>" class="btn btn-outline" style="padding: 0.6rem 1.25rem;">
        <i class="fa-solid fa-building-columns"></i> Explorar Catálogo
      </a>
    </div>
  </div>
</div>
