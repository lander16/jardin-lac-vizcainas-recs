<% content_for :title, "Error del Servidor (500) - Jardín LAC Vizcaínas" %>

<div class="error-page-wrap">
  <div class="glass-card error-card">
    <div class="error-icon error-icon--warning">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    </div>

    <h1 class="error-title">Error Temporal en el Servidor (500)</h1>

    <p class="error-copy">
      Ocurrió una interrupción al procesar la solicitud en el motor de recomendaciones. Nuestro equipo técnico ha sido notificado.
    </p>

    <div class="error-actions">
      <%= link_to root_path, class: "btn btn-primary error-action-btn" do %>
        <i class="fa-solid fa-house" aria-hidden="true"></i> Volver al Inicio
      <% end %>
      <a href="<%= root_path %>"
         class="btn btn-outline error-action-btn"
         data-controller="navigation"
         data-action="click->navigation#back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Regresar
      </a>
    </div>
  </div>
</div>
