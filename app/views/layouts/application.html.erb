<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= content_for(:title) || "Sistema de Recomendaciones - Jardín LAC Vizcaínas" %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <meta name="description" content="Sistema de Recomendaciones y Catálogo Inteligente de Jardín LAC Vizcaínas. Recomendaciones de lectura híbridas basadas en similitud temática, afinidad de lectores y autoridades catalográficas." />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📖</text></svg>">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#router-view" class="skip-link">Saltar al contenido principal</a>

    <% dashboard_active = %w[dashboard users books].include?(controller_name) %>
    <% catalog_active = controller_name == "catalog" %>

    <header>
      <a href="<%= root_path %>" class="logo">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        <span>Jardín LAC Vizcaínas</span>
      </a>
      <nav class="nav-links" aria-label="Navegación principal">
        <a href="<%= root_path %>"
           class="nav-link <%= 'active' if dashboard_active %>"
           <%= 'aria-current="page"' if dashboard_active %>
           id="nav-dashboard">
          <i class="fa-solid fa-chart-line" aria-hidden="true"></i> Inicio
        </a>
        <a href="<%= catalog_path %>"
           class="nav-link <%= 'active' if catalog_active %>"
           <%= 'aria-current="page"' if catalog_active %>
           id="nav-catalog">
          <i class="fa-solid fa-building-columns" aria-hidden="true"></i> Catálogo
        </a>
      </nav>
    </header>

    <main class="container" id="router-view" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="site-footer">
      &copy; <%= Time.current.year %> Jardín LAC Vizcaínas &bull; Sistema de Recomendaciones
    </footer>
  </body>
</html>
