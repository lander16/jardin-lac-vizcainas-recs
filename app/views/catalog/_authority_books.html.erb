<%= turbo_frame_tag "inspector-books-panel" do %>
  <div class="authority-books-header">
    <div class="authority-books-type">
      <i class="fa-solid fa-tag" aria-hidden="true"></i> <%= authority.authority_type %>
    </div>
    <h3 class="authority-books-title"><%= authority.name %></h3>
    <p class="authority-books-count">
      Esta etiqueta agrupa un total de <strong><%= pluralize_es(authority.books_count, "obra", "obras") %></strong> en el catálogo del Colegio de las Vizcaínas.
    </p>
    <% if authority.books_count > books.size %>
      <p class="authority-books-note">
        Mostrando las primeras <%= books.size %> de <%= number_with_delimiter(authority.books_count) %> obras.
      </p>
    <% end %>
  </div>

  <div class="authority-books-list">
    <% if books.empty? %>
      <div class="authority-books-empty">No hay libros asociados a este descriptor.</div>
    <% else %>
      <% books.each do |book| %>
        <div class="authority-book-row">
          <div class="authority-book-info">
            <%= link_to book.title, book_path(book.id), data: { turbo_frame: "_top" }, class: "book-title-link", title: book.title %>
            <% if book.author.present? %>
              <div class="authority-book-author"><i class="fa-solid fa-feather" aria-hidden="true"></i> <%= book.author %></div>
            <% end %>
          </div>
          <%= link_to catalog_graph_path(book.id), data: { turbo_frame: "_top" }, class: "btn btn-outline book-graph-link" do %>
            <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Ver Grafo
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
