<% content_for :title, "Grafo de Autoridades de #{@book.title} - Jardín LAC Vizcaínas" %>

<div class="page-actions-bar">
  <%= link_to catalog_path, class: "btn btn-secondary back-nav-btn" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver al Catálogo
  <% end %>
</div>

<div class="glass-card graph-hero-card">
  <div class="graph-hero-header">
    <i class="fa-solid fa-diagram-project graph-hero-icon graph-hero-icon--authority" aria-hidden="true"></i>
    <div>
      <h1 class="graph-hero-title">
        Grafo de Conexiones Catalográficas: <%= @book.title %>
      </h1>
      <p class="graph-hero-subtitle">
        Red de autoridades compartidas (Autores, Temas, Lugares, Organizaciones) que vinculan esta obra con el acervo.
      </p>
    </div>
  </div>
  <div class="graph-help-row">
    <span class="graph-help-chip"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Arrastra nodos</span>
    <span class="graph-help-chip"><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i> Rueda para zoom</span>
    <span class="graph-help-chip"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Clic o Enter para detalles</span>
  </div>
</div>

<div class="graph-split" data-controller="d3-catalog-graph" data-d3-catalog-graph-url-value="<%= api_catalog_graph_path(@book.id) %>">
  <div class="glass-card graph-canvas-card">
    <div class="graph-toolbar" role="toolbar" aria-label="Controles de zoom del grafo">
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-catalog-graph#zoomIn"
              data-d3-catalog-graph-target="zoomControl"
              aria-label="Acercar grafo"
              title="Acercar">+</button>
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-catalog-graph#zoomOut"
              data-d3-catalog-graph-target="zoomControl"
              aria-label="Alejar grafo"
              title="Alejar">-</button>
      <button type="button"
              class="btn btn-secondary btn-compact graph-zoom-btn"
              data-action="click->d3-catalog-graph#resetZoom"
              data-d3-catalog-graph-target="zoomControl">Restablecer</button>
    </div>

    <div class="graph-loading-state" data-d3-catalog-graph-target="loading">
      <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
      <span>Cargando grafo…</span>
    </div>
    <div id="catalog-graph" class="graph-canvas" data-d3-catalog-graph-target="container"></div>

    <div class="graph-legend">
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--target-catalog" aria-hidden="true"></span> Obra Principal
      </div>
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--authority" aria-hidden="true"></span> Autoridad Catalogada
      </div>
      <div class="graph-legend-item">
        <span class="graph-legend-dot graph-legend-dot--connected-book" aria-hidden="true"></span> Obra Vinculada por Red
      </div>
    </div>
  </div>

  <div class="glass-card graph-panel" data-d3-catalog-graph-target="panel" aria-live="polite">
    <div class="graph-panel-placeholder">
      <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
      <p class="graph-panel-placeholder-title">Selecciona un nodo del grafo</p>
      <p class="graph-panel-placeholder-copy">Haz clic en una autoridad u obra conectada para inspeccionar sus detalles catalográficos.</p>
    </div>
  </div>
</div>
