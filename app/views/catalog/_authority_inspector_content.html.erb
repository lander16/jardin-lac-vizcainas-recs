<%= turbo_frame_tag "authority-inspector" do %>
  <div class="inspector-shell">
    <div class="inspector-header">
      <div class="inspector-title-group">
        <div class="inspector-icon-badge">
          <i class="fa-solid fa-tag" aria-hidden="true"></i>
        </div>
        <div>
          <h2 id="authority-inspector-title" class="inspector-title"><%= auth_type %></h2>
          <p class="inspector-subtitle">Análisis y desglose de descriptores catalogados en Koha</p>
        </div>
      </div>

      <div class="inspector-stats">
        <div>
          <div class="inspector-stat-label">Etiquetas Únicas</div>
          <div class="inspector-stat-value"><%= number_with_delimiter(type_stats[:total_authorities]) %></div>
        </div>
        <div>
          <div class="inspector-stat-label">Promedio de Libros</div>
          <div class="inspector-stat-value"><%= type_stats[:avg_books_per_authority] %></div>
        </div>
        <div class="inspector-stat-top">
          <div class="inspector-stat-label">Etiqueta Más Común</div>
          <div class="inspector-stat-value inspector-stat-value--truncate" title="<%= type_stats[:top_authority_name] %>">
            <%= type_stats[:top_authority_name] || "Ninguna" %>
            <span class="inspector-stat-sub">(<%= number_with_delimiter(type_stats[:top_authority_count]) %> lib.)</span>
          </div>
        </div>
      </div>

      <button type="button"
              class="inspector-close-btn"
              aria-label="Cerrar inspector de autoridades"
              data-action="click->modal#closeInspector">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="inspector-body">
      <div class="inspector-sidebar">
        <div id="inspector-tags-list" class="inspector-tags-list">
          <% authorities.each do |auth| %>
            <%= link_to catalog_authority_detail_path(auth.id),
                        data: { turbo_frame: "inspector-books-panel", action: "click->modal#selectAuthority" },
                        class: "tag-list-item" do %>
              <span class="tag-name" title="<%= auth.name %>"><%= auth.name %></span>
              <span class="tag-count"><%= number_with_delimiter(auth.books_count) %> lib.</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= turbo_frame_tag "inspector-books-panel", class: "inspector-books-panel" do %>
        <div class="inspector-empty-panel">
          <i class="fa-solid fa-tag" aria-hidden="true"></i>
          <p class="inspector-empty-title">Selecciona un descriptor de la izquierda</p>
          <p class="inspector-empty-copy">Verás el listado de obras del acervo que comparten esta autoridad catalogada.</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
