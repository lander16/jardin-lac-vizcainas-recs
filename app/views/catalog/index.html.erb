<% content_for :title, "Catálogo Koha e Inspector de Autoridades - Jardín LAC Vizcaínas" %>

<section class="hero hero--compact-bottom">
  <h1>Catálogo del Acervo y Red de Autoridades</h1>
  <p>Explora la estructura catalográfica oficial de Koha del Colegio de las Vizcaínas mediante búsqueda inteligente y grafos interconectados.</p>
</section>

<div class="catalog-stats-grid">
  <div class="glass-card stat-card">
    <div class="stat-icon books">
      <i class="fa-solid fa-book" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Libros Catalogados</p>
      <p class="stat-value"><%= number_with_delimiter(@total_books) %></p>
    </div>
  </div>

  <div class="glass-card stat-card">
    <div class="stat-icon users">
      <i class="fa-solid fa-tags" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Etiquetas Únicas</p>
      <p class="stat-value"><%= number_with_delimiter(@total_authorities) %></p>
    </div>
  </div>

  <div class="glass-card stat-card">
    <div class="stat-icon checkouts">
      <i class="fa-solid fa-link" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Etiquetas por Libro</p>
      <p class="stat-value"><%= @avg_authorities_per_book %></p>
    </div>
  </div>

  <div class="glass-card stat-card">
    <div class="stat-icon books">
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Libros por Etiqueta</p>
      <p class="stat-value"><%= @avg_books_per_authority %></p>
    </div>
  </div>

  <div class="glass-card stat-card">
    <div class="stat-icon checkouts">
      <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Conexiones Fuertes</p>
      <p class="stat-value"><%= number_with_delimiter(@total_connections) %></p>
    </div>
  </div>

  <div class="glass-card stat-card">
    <div class="stat-icon users">
      <i class="fa-solid fa-circle-nodes" aria-hidden="true"></i>
    </div>
    <div class="stat-info">
      <p class="stat-label">Interconexión</p>
      <p class="stat-value"><%= @percentage_connected %>%</p>
    </div>
  </div>
</div>

<div data-controller="modal">
  <div class="dashboard-grid">
    <div class="glass-card"
         data-controller="search"
         data-search-url-value="<%= catalog_search_path %>"
         data-search-singular-value="resultado"
         data-search-plural-value="resultados">
      <div class="section-title">
        <i class="fa-solid fa-magnifying-glass section-title-icon--accent" aria-hidden="true"></i>
        <h2>Búsqueda Inteligente en Catálogo</h2>
      </div>

      <form role="search"
            action="<%= catalog_path %>"
            method="get"
            class="search-form"
            data-action="submit->search#submitNow">
        <div class="search-container">
          <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
            <label for="catalog-search-input" class="sr-only">Buscar por título, autor, tema o lugar</label>
            <input type="search"
                   id="catalog-search-input"
                   name="q"
                   value="<%= @query %>"
                   class="search-input"
                   placeholder="Buscar por título, autor, tema o lugar (ej. 'Hess', 'México', 'Revolución')..."
                   data-search-target="input"
                   data-action="input->search#input">
          </div>
          <button type="button"
                  class="search-clear-btn"
                  data-search-target="clear"
                  data-action="click->search#clear"
                  hidden>
            Limpiar
          </button>
        </div>
      </form>
      <div class="search-feedback-row">
        <p class="search-status" data-search-target="status" aria-live="polite">
          Mostrando <%= pluralize_es(@books.size, "resultado", "resultados") %>
        </p>
      </div>

      <% if @semantic_search_available %>
        <div class="semantic-pill"
             title="Las búsquedas combinan coincidencia literal (título, autor, autoridad) con similitud semántica vía embeddings (sentence-transformers).">
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Búsqueda semántica activa
        </div>
      <% end %>

      <%= turbo_frame_tag "catalog-results", data: { search_target: "frame" } do %>
        <%= render "catalog/search_results_content", books: @books, query: @query %>
      <% end %>
    </div>

    <div class="sidebar-stack">
      <div class="glass-card">
        <div class="section-title">
          <i class="fa-solid fa-list-check section-title-icon--authority" aria-hidden="true"></i>
          <h2>Tipos de Autoridad</h2>
        </div>
        <p class="section-subtitle">
          Haz clic en una categoría para inspeccionar sus descriptores y obras vinculadas.
        </p>

        <div class="catalog-types-list">
          <% @type_counts.each do |type, count| %>
            <button type="button"
                    class="catalog-type-chip"
                    data-action="click->modal#openAuthorityInspector"
                    data-modal-type-param="<%= type %>">
              <span class="catalog-type-label">
                <i class="fa-solid fa-tag" aria-hidden="true"></i> <%= type %>
              </span>
              <span class="catalog-type-badge">
                <%= number_with_delimiter(count) %>
              </span>
            </button>
          <% end %>
        </div>
      </div>

      <div class="glass-card">
        <div class="section-title">
          <i class="fa-solid fa-fire section-title-icon--hybrid" aria-hidden="true"></i>
          <h2>Obras con Mayor Red de Conexiones</h2>
        </div>

        <div class="popular-books-list">
          <% @popular_books.each_with_index do |b, idx| %>
            <div class="popular-book-row">
              <div class="popular-book-main">
                <span class="popular-book-rank">#<%= idx + 1 %></span>
                <%= link_to b.title, catalog_graph_path(b.id), class: "book-title-link", title: b.title %>
              </div>
              <% connections_label = pluralize_es(b.connections_count, "conexión", "conexiones") %>
              <%= link_to catalog_graph_path(b.id),
                          class: "source-badge authority popular-book-badge",
                          title: connections_label,
                          aria: { label: "#{b.title}: #{connections_label}" } do %>
                <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> <%= b.connections_count %> con.
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <dialog id="authority-inspector-modal"
          class="inspector-modal"
          data-modal-target="inspectorDialog"
          data-action="click->modal#backdropClose"
          aria-labelledby="authority-inspector-title">
    <div class="inspector-modal-card">
      <%= turbo_frame_tag "authority-inspector" do %>
        <div class="inspector-modal-loading">
          <i class="fa-solid fa-spinner fa-spin fa-2x" aria-hidden="true"></i>
          <span>Cargando autoridades…</span>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
