<% result_count = books.size %>
<div class="catalog-results-shell">
  <div class="catalog-results-summary">
    <% if query.present? %>
      <div>
        <p class="catalog-results-kicker">Búsqueda</p>
        <h3>“<%= query %>”</h3>
      </div>
      <span class="search-result-count"><%= result_count %> resultado<%= "s" unless result_count == 1 %></span>
    <% else %>
      <div>
        <p class="catalog-results-kicker">Selección inicial</p>
        <h3>Libros recientes del acervo</h3>
      </div>
      <span class="search-result-count"><%= result_count %> resultado<%= "s" unless result_count == 1 %></span>
    <% end %>
  </div>

  <div class="catalog-results-list">
    <% if books.empty? %>
      <div class="empty-state-card">
        <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
        <p class="empty-state-title">No se encontraron resultados.</p>
        <% if QueryEmbedder.default.available? %>
          <p class="empty-state-copy">Prueba con un sinónimo, autor, tema o lugar cercano.</p>
        <% else %>
          <p class="empty-state-copy">Intenta ajustar el término de búsqueda.</p>
        <% end %>
      </div>
    <% else %>
      <% books.each do |b| %>
        <% b_id = b.is_a?(Hash) ? b[:biblio_id] : b.id %>
        <% b_title = b.is_a?(Hash) ? b[:title] : b.title %>
        <% b_author = b.is_a?(Hash) ? b[:author] : b.author %>
        <% b_score = b.is_a?(Hash) ? b[:match_score] : nil %>
        <% b_exp = b.is_a?(Hash) ? b[:match_explanation] : nil %>
        <% b_conns = b.is_a?(Hash) ? (b[:connection_count] || 0) : (b.outgoing_connections.size + b.incoming_connections.size) %>
        <% b_auths = b.is_a?(Hash) ? (b[:authorities] || []) : b.authorities.map { |a| { name: a.name } } %>

        <div class="catalog-book-card" data-search-result-item>
          <div class="catalog-book-header">
            <div class="catalog-book-info">
              <div style="display:flex; align-items:flex-start; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.3rem;">
                <a href="<%= book_path(b_id) %>" data-turbo-frame="_top" class="catalog-book-title"><%= b_title %></a>
                <% if b_score %>
                  <span class="similarity-badge"><%= b_score %> pts</span>
                <% end %>
              </div>

              <% if b_author.present? %>
                <div class="catalog-book-author">
                  <i class="fa-solid fa-feather" aria-hidden="true"></i> <%= b_author %>
                </div>
              <% end %>

              <% if b_exp.present? %>
                <div class="search-match-explanation">
                  <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
                  <span><%= b_exp %></span>
                </div>
              <% end %>

              <% if b_auths.present? %>
                <div class="catalog-auth-list" style="margin-top:0.6rem;">
                  <% b_auths.first(5).each do |auth| %>
                    <span class="catalog-auth-badge clickable-auth-badge">
                      <i class="fa-solid fa-tag" aria-hidden="true"></i> <%= auth[:name] || auth.name %>
                    </span>
                  <% end %>
                  <% if b_auths.size > 5 %>
                    <span style="font-size:0.72rem; color:var(--text-muted); align-self:center;">
                      +<%= b_auths.size - 5 %> más
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="catalog-book-meta-right">
              <a href="<%= catalog_graph_path(b_id) %>" data-turbo-frame="_top" class="btn btn-secondary btn-compact">
                <i class="fa-solid fa-diagram-project"></i> Grafo · <%= b_conns %>
              </a>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
