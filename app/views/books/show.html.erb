<% content_for :title, "#{@book.title} - Jardín LAC Vizcaínas" %>

<div class="page-actions-bar">
  <%= link_to catalog_path,
              class: "btn btn-secondary back-nav-btn",
              data: { controller: "navigation", action: "click->navigation#back" } do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver
  <% end %>
</div>

<div class="dashboard-grid">
  <div class="glass-card">
    <div class="book-detail-header">
      <div class="book-detail-heading">
        <span class="source-badge content book-detail-code">
          <i class="fa-solid fa-book" aria-hidden="true"></i> Código de la Obra: <%= @book.id %>
        </span>
        <h1 class="book-detail-title"><%= @book.title %></h1>
        <% if @book.author.present? %>
          <div class="book-detail-author">
            <i class="fa-solid fa-feather" aria-hidden="true"></i> <%= @book.author %>
          </div>
        <% end %>
      </div>

      <%= link_to catalog_graph_path(@book.id), class: "btn btn-primary book-detail-graph-btn" do %>
        <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Grafo de Autoridades
      <% end %>
    </div>

    <div class="book-detail-section">
      <h2 class="book-detail-section-title">Sinopsis / Descripción</h2>
      <p class="book-detail-description">
        <%= @book.description.presence || "No hay descripción disponible para esta obra en la base de datos." %>
      </p>
    </div>

    <% if @book.authorities.any? %>
      <div class="book-detail-section">
        <h2 class="book-detail-section-title">Autoridades Catalogadas</h2>
        <div class="catalog-auth-list">
          <% @book.authorities.each do |auth| %>
            <%= link_to catalog_path(q: auth.name), class: "catalog-auth-badge" do %>
              <i class="fa-solid fa-tag" aria-hidden="true"></i>
              <strong><%= auth.authority_type %>:</strong> <%= auth.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="book-detail-section">
      <h2 class="book-detail-section-title">
        Historial de Lecturas (<%= pluralize_es(@checked_by.size, "lector", "lectores") %>)
      </h2>
      <% if @checked_by.empty? %>
        <p class="book-detail-empty-note">Esta obra no ha sido solicitada por ningún lector todavía.</p>
      <% else %>
        <div class="book-detail-patrons">
          <% @checked_by.each do |patron| %>
            <%= link_to user_path(patron.id), class: "btn btn-secondary book-patron-link" do %>
              <i class="fa-regular fa-user" aria-hidden="true"></i> <%= patron.name %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="glass-card">
    <div class="section-title">
      <i class="fa-solid fa-tag section-title-icon--content" aria-hidden="true"></i>
      <h2>Títulos Similares</h2>
    </div>
    <p class="section-subtitle">
      Generados mediante la distancia vectorial de similitud y descriptores catalográficos compartidos.
    </p>

    <div class="similar-books-list">
      <% if @similar_books.empty? %>
        <div class="similar-books-empty">
          No se encontraron obras similares.
        </div>
      <% else %>
        <% @similar_books.each do |sim| %>
          <% b = sim[:book] %>
          <% pct = sim[:percentage] %>
          <div class="similar-book-card">
            <div class="similar-book-top">
              <%= link_to b.title, book_path(b.id), class: "similar-book-link", title: b.title %>
              <span class="similarity-badge"><%= pct %>% afinidad</span>
            </div>
            <% if b.author.present? %>
              <div class="similar-book-author">
                <i class="fa-solid fa-feather" aria-hidden="true"></i> <%= b.author %>
              </div>
            <% end %>
            <div class="score-track similar-book-track">
              <div class="score-fill content" style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
